# SSD1677 + LVGL 9.6 example
# Board: Metalio E-Ink 4 (ESP32-S3, 16 MB flash, octal PSRAM)
# Panel: GDEM0397T81-class 800x480, shown as 480x800 portrait

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Metalio: console on USB-Serial/JTAG (UART0 pins are used by the board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL renders 8-bit luminance (L8); esp_epaper quantizes it in flush_cb
CONFIG_LV_COLOR_FORMAT_L8=y
CONFIG_LV_DRAW_SW_SUPPORT_L8=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
